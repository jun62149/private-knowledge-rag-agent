# ============================================================
#  复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）
#     cp .env.example .env
#  优先级：进程环境变量 > .env > 代码默认值
# ============================================================

# ---- LLM：DeepSeek（OpenAI 兼容）----
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL_NAME=deepseek-v4-flash

# ---- Reranker：硅基流动 SiliconFlow ----
# 申请：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ---- 心知天气（weather check 工具）----
# 申请：https://www.seniverse.com
WEATHER_API_KEY=

# ---- SerpAPI（web search 工具）----
# 申请：https://serpapi.com ；留空则该工具会返回明确提示而不是崩溃
SERPAPI_KEY=

# ---- 可选：本地 Embedding 模型路径 ----
# 默认取 <项目根>/model/bge-large-zh-v1__5（可用 utils/downloader.py 从 ModelScope 下载）
# EMBEDDING_MODEL_PATH=/absolute/path/to/bge-large-zh-v1__5

# ---- 可选：检索参数覆盖 ----
# SEARCH_CANDIDATE_K=10
# RERANK_TOP_N=3
# RERANK_MAX_DOC_CHARS=2000
# TIME_OUT=60
